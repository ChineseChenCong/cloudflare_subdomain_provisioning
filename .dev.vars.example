# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# JWT 密钥（随机生成32位以上字符串）
JWT_SECRET=your_jwt_secret_key_here

# Cloudflare API Token（需要 Zone > DNS > Edit 和 Zone > Zone > Read 权限）
CF_API_TOKEN=your_cloudflare_api_token

# 域名列表（逗号分隔，Zone ID 自动解析）
DOMAINS=example.com,example.org

# 禁止的前缀
BANNED_PREFIXES=www,ns1,ns2,ns,mc,mail,smtp,pop,pop3,imap,ftp,admin,api,cdn,dev,staging,test,beta,alpha,demo,status,blog,shop,store,app,dashboard,panel,portal,secure,vpn,proxy,relay,mx,mx1,mx2,autoconfig,autodiscover,_dmarc,_domainkey,cpanel,webmail,webdisk,cpcalendars,cpcontacts,ww,ww1,ww2,ww3

# 每用户最多子域名数
MAX_SUBDOMAINS_PER_USER=1

# 每子域名最多 DNS 记录数
MAX_RECORDS_PER_SUBDOMAIN=20

# 管理员 GitHub 用户名（逗号分隔）
ADMIN_USERS=your_github_username

# 站点名称
SITE_NAME=SubDomain Hub

# ========== 新增配置 ==========

# 加密密钥（用于加密敏感数据，随机生成32位以上字符串）
ENCRYPTION_KEY=your_encryption_key_here

# 是否要求邮箱验证（true/false）
EMAIL_VERIFICATION_REQUIRED=true

# 允许的邮箱域名白名单（逗号分隔，留空=不限制）
ALLOWED_EMAIL_DOMAINS=gmail.com,outlook.com,qq.com,163.com,126.com,foxmail.com,icloud.com

# ========== 邮件通知（可选） ==========

# 外部 SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=SubDomain Hub

# ========== 站点外观定制（可选） ==========

# 背景图片 URL
SITE_BACKGROUND_IMAGE=

# 背景遮罩颜色（默认 rgba(15, 23, 42, 0.7)，不配置则用默认深色遮罩）
SITE_BACKGROUND_OVERLAY=rgba(15, 23, 42, 0.7)

# 站点 Logo URL（不配置则使用内置默认萌系 Logo）
SITE_LOGO=

# ========== 友情链接 & 联系管理员（可选） ==========

# 友情链接（JSON 数组，不配置则不显示）
# FRIEND_LINKS=[{"name":"我的博客","url":"https://blog.example.com"},{"name":"朋友站点","url":"https://friend.example.com"}]

# 联系管理员邮箱（配置后底部显示"联系管理员"按钮，点击发邮件）
ADMIN_CONTACT_EMAIL=admin@example.com

# ========== 备案信息（可选，虚拟备案项目） ==========

# 网站底部备案信息（配置则显示，不配置则不显示）
# SITE_BEIAN=浙ICP备12345678号-1
