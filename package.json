{
  "name": "cloudflare-subdomain-provisioning",
  "version": "2.0.0",
  "description": "Cloudflare Workers 二级域名分发服务（支持多账户、加密、邮箱验证）",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cf --local",
    "db:migrate:remote": "wrangler d1 migrations apply cf --remote",
    "db:export": "wrangler d1 export cf --remote --output=./snapshot.sql",
    "deploy:migrate": "npm run db:migrate:remote && npm run deploy"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.131.2"
  }
}
